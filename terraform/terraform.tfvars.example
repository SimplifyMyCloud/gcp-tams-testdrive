# GCP TAMS Test Drive Configuration
# Copy this file to terraform.tfvars and customize for your environment

project_id = "smc-gcp-tams-testdrive"
region     = "us-central1"
zone       = "us-central1-a"

# IAP Configuration
# Add authorized users/groups that can access TAMS via IAP
iap_users = [
  "user:your-email@example.com",
  # "group:your-team@example.com",
]

# Database Configuration
db_tier = "db-f1-micro" # Use db-g1-small or larger for production
